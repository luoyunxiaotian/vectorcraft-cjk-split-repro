                "runs": [
                  {
                    "text": "方寸班级，是梦想启航的港湾；星光校园，是梦想绽放的舞台。我们相信，每一个孩子都是一颗等待绽放的种子，只要用心浇灌、用爱陪伴，他们定能绽放出属于自己的精彩。",
                    "style": {
                      "font_family": "Microsoft YaHei",
                      "font_style": "Regular",
                      "size": 9.0,
                      "tracking": 0.0,
                      "baseline_shift": 0.0,
                      "h_scale": 100.0,
                      "v_scale": 100.0,
                      "rotation": 0.0,
                      "fill": {
                        "type": "solid",
                        "color": {
                          "model": "rgb",
                          "r": 0.2,
                          "g": 0.2,
                          "b": 0.2
                        }
                      },
                      "stroke": {
                        "type": "none"
                      },
                      "stroke_width": 0.0,
                      "underline": false,
                      "strikethrough": false,
                      "all_caps": false
                    }
                  }
                ],
                "para": {
                  "justify": "Left",
